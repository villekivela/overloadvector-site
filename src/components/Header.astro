---
// Every page's header: the mark and the name, the docs and the FAQ, then the search and the theme
// menu. The home page has nothing to search for, so it has no search.
import Search from "virtual:starlight/components/Search";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import Mark from "./Mark.astro";

const { id } = Astro.locals.starlightRoute.entry;
const home = id === "index" || id === "";
const here = (part: boolean) => (part ? "page" : undefined);
---

<div class="site-head">
  <a href="/" class="site-title"><Mark />Overload Vector</a>
  <nav class="site-links" aria-label="Site">
    <a href="/docs/getting-started/" aria-current={here(id.startsWith("docs/"))}>Docs</a>
    <a href="/faq/" aria-current={here(id === "faq")}>FAQ</a>
  </nav>
  {!home && <div class="site-search print:hidden"><Search /></div>}
  <div class="site-theme print:hidden"><ThemeSelect /></div>
</div>

<style>
  .site-head {
    display: flex;
    align-items: stretch;
    gap: clamp(0.75rem, 2.5vw, 2rem);
    height: 100%;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-inline-end: auto;
    font: 800 clamp(1.1875rem, 0.9rem + 1vw, 1.625rem) / 1 var(--ov-font-title);
    font-stretch: 75%;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ov-ink);
  }
  .site-title :global(svg) {
    flex: none;
    width: auto;
    height: 1.15em;
  }
  .site-links {
    display: flex;
    align-items: stretch;
    gap: inherit;
    /* To the header's own edges, so the line under the current part lies on the header's rule. */
    margin-block: calc(-1 * var(--sl-nav-pad-y));
  }
  .site-links a {
    display: flex;
    align-items: center;
    color: var(--ov-muted);
    text-decoration: none;
  }
  .site-links a:hover {
    color: var(--ov-ink);
  }
  .site-links a[aria-current] {
    color: var(--ov-ink);
    box-shadow: inset 0 -3px var(--ov-signal);
  }
  .site-search,
  .site-theme {
    display: flex;
    align-items: center;
  }
  /* A narrow page with a sidebar has these in its menu, whose button stands at the header's end. */
  @media (max-width: 49.99rem) {
    :global([data-has-sidebar]) :is(.site-links, .site-theme) {
      display: none;
    }
  }
</style>
