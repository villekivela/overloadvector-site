---
// The home page: the pitch, then what the app does, section by section, beside one phone. On a wide screen the
// phone is a live 3D model (src/phone/) that turns a little into place as the scroll begins, then
// stands still, pinned, while its screen changes or plays a section's clip. A narrow screen, a
// visitor who asked for less motion and a browser without WebGL get a still of the same phone with
// each text, and never load three.js or a clip.
import { getImage, Image } from "astro:assets";
import BigMark from "./BigMark.astro";
import Mark from "./Mark.astro";

const BETA = "https://github.com/villekivela/overloadvector-releases/releases/latest";
const INSTALL = "/docs/getting-started/";

// Each thing the app does for the reader: a heading that says what the reader gets, one sentence, a
// small working model of it (below, by `kicker`), and three particulars. `screens` are what the
// phone shows as the section passes, each with its words in `alts`.
const FEATURES = [
  {
    screens: ["new-program"],
    kicker: "Program",
    title: "A program built for your week and your gym",
    text: "Pick your training days and your gym's equipment. The app writes a periodized program on the phone, ready to start the same day.",
    points: [
      "Blocks, weeks and days, with weekly set targets per muscle",
      "Built for the equipment your gym has",
      "Or import a program file of your own",
    ],
    more: { text: "How programs work", href: "/docs/programs/" },
    alts: ["A new program for review, with its weekly sets per muscle shown on the mannequin"],
  },
  {
    screens: ["logging"],
    kicker: "Logging",
    title: "Log every set in a few taps",
    text: "Weight, reps, reps in reserve. The app fills in the weight it suggests, so a set done as planned takes its reps and one tap.",
    points: [
      "Warm-up sets and the plates for each side, worked out for you",
      "A rest timer that buzzes when rest is over",
      "Drop sets, myo-reps and other intensity techniques",
    ],
    more: { text: "How logging works", href: "/docs/logging/" },
    alts: ["Logging a set: weight, reps and reps in reserve, with the rest timer running"],
  },
  {
    screens: ["mannequin", "muscles"],
    kicker: "Technique",
    title: "See how every lift is done",
    text: "A 3D mannequin does each exercise on the machine your gym has. Watch the rep before you load the bar.",
    points: [
      "Step through the rep, phase by phase",
      "See which muscles each exercise works",
      "Technique videos, a tap away",
    ],
    more: { text: "How exercises are shown", href: "/docs/logging/#moving-between-exercises" },
    alts: [
      "An exercise's details: the mannequin doing a Smith machine RDL, and the muscles it works",
      "An exercise's details with the muscles layer on: the mannequin doing a Smith machine RDL, its working muscles lit up",
    ],
  },
  {
    screens: ["progress"],
    kicker: "Progression",
    title: "Know what to lift next",
    text: "Every exercise gets its next weight, worked out from the reps and reps in reserve you logged last time.",
    points: [
      "Only weights your gym can load",
      "Every suggestion says why",
      "Weekly sets per muscle, tracked against your targets",
    ],
    more: { text: "How progression works", href: "/docs/progression/" },
    alts: ["The week's sets per muscle against their targets"],
  },
  {
    screens: ["check-in"],
    kicker: "Coaching",
    title: "Replan when the week changes",
    text: "Sore wrist, short evening, hotel gym? Tell Claude, and it proposes what to change.",
    points: [
      "For pain, too little time and missing equipment",
      "Nothing changes until you accept it",
      "Needs an Anthropic API key or a Claude account",
    ],
    more: { text: "How coaching works", href: "/docs/coaching/" },
    alts: ["The coach asking what's going on: pain, short on time, another gym and more"],
  },
];
// What a visitor asks first, under the hero.
// Each fact's icon is the path of a 24-unit drawing: a phone, a price tag, a shield.
const FACTS = [
  { text: "Android 8.0 or newer", icon: "M7 2.5h10a1.5 1.5 0 0 1 1.5 1.5v16a1.5 1.5 0 0 1-1.5 1.5H7A1.5 1.5 0 0 1 5.5 20V4A1.5 1.5 0 0 1 7 2.5ZM10 18.5h4" },
  { text: "Free in the beta", icon: "M3.5 3.5h8l9 9-8 8-9-9v-8ZM8 8h.01" },
  { text: "No account, no ads, no trackers", icon: "M12 2.5l8 3v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10v-6l8-3ZM8.5 12l2.5 2.5 4.5-5" },
];
const TODAY = {
  screen: "today",
  alt: "Today in Overload Vector: the week's calendar and the next day to train, with the muscles it works",
};

const files = (pattern: Record<string, { default: ImageMetadata }>) => (name: string) => {
  const found = Object.entries(pattern).find(([path]) => path.endsWith(`/${name}.png`));
  if (!found) throw new Error(`no image ${name}.png`);
  return found[1].default;
};
const still = files(import.meta.glob("../assets/phone/phone-*.png", { eager: true }));
const shot = files(import.meta.glob("../assets/shots/shot-*.png", { eager: true }));
// A screen with a clip (src/assets/clips/, made by npm run clips) plays it on the live phone, and
// shows the clip's first frame until it plays.
const poster = files(import.meta.glob("../assets/clips/clip-*.png", { eager: true }));
const videos = import.meta.glob<string>("../assets/clips/clip-*.{webm,mp4}", { eager: true, query: "?url", import: "default" });
const video = (name: string) => Object.entries(videos).find(([path]) => path.endsWith(`/${name}`))?.[1];

type Clip = { webm: string; mp4: string };
// What the live phone puts on its screen: each screenshot's address, per theme, and a clip's.
type Span = [from: number, to: number];
const screens: Record<string, { light: string; dark: string; alt: string; clip?: { light: Clip; dark: Clip }; lit?: { light: Span; dark: Span } }> = {};
// Technique's clip turns the muscles layer on and off: the seconds of each theme's clip between
// which its muscles are lit. The list beside the phone lights and dims with it. Measure these
// again whenever the clip is cut again (README, "Clips").
const LIT: Record<string, { light: Span; dark: Span }> = { mannequin: { dark: [1.27, 4.73], light: [0.8, 4.27] } };
// A section whose screen has a clip puts only that on the live phone: the clip shows the rest
// (Technique's plays the mannequin with its muscles on, and off). The pictures keep them all.
const played = (screen: string) => Boolean(video(`clip-${screen}-light.webm`));
const live = (screens: string[]) => {
  const clipped = screens.find(played);
  return clipped ? [clipped] : screens;
};
const shown = [TODAY, ...FEATURES.flatMap(({ screens, alts }) => live(screens).map((screen, at) => ({ screen, alt: alts[at] })))];
for (const { screen, alt } of shown) {
  const picture = (theme: string) => (played(screen) ? poster(`clip-${screen}-${theme}`) : shot(`shot-${screen}-${theme}`));
  const [light, dark] = await Promise.all(
    ["light", "dark"].map((theme) => getImage({ src: picture(theme), format: "webp", quality: 90 })),
  );
  screens[screen] = { light: light.src, dark: dark.src, alt };
  if (!played(screen)) continue;
  const clip = (theme: string) => {
    const [webm, mp4] = ["webm", "mp4"].map((kind) => video(`clip-${screen}-${theme}.${kind}`));
    if (!webm || !mp4) throw new Error(`clip-${screen}-${theme} needs a .webm and an .mp4`);
    return { webm, mp4 };
  };
  screens[screen].clip = { light: clip("light"), dark: clip("dark") };
  if (LIT[screen]) screens[screen].lit = LIT[screen];
}

// Program: the block as it is, a column a week and a row a training day. Four weeks are done,
// and in week 5 the first day is done and the second is next.
const WEEKS = Array.from({ length: 12 }, (_, week) => week + 1);
const DAYS = ["A", "B", "C"];
const NOW = { week: 5, day: 1 };
const dayState = (week: number, day: number) =>
  week < NOW.week || (week === NOW.week && day < NOW.day) ? "done" : week === NOW.week && day === NOW.day ? "now" : undefined;

// Logging: how hard a set was, in the app's reps-in-reserve colours.
const RIR = [
  { label: "0", tone: "r0", say: "0 in reserve. That was the last rep possible." },
  { label: "1", tone: "r1", say: "1 in reserve. One more rep was possible." },
  { label: "2", tone: "r1", say: "2 in reserve. Two more reps were possible.", pressed: true },
  { label: "3", tone: "r3", say: "3 in reserve. Three more reps were possible." },
  { label: "4+", tone: "r3", say: "4 or more in reserve. An easy set." },
];

// Technique: the muscles a Smith machine RDL works, and how much of each, as the mannequin lights them.
const MUSCLES = [
  ["Lower back", 1],
  ["Hamstrings", 0.5],
  ["Glutes", 0.5],
  ["Forearm flexors", 0.5],
  ["Traps", 0.5],
  ["Lats", 0.5],
  ["Mid traps", 0.5],
] as const;

// Progression: how the last session went, and the weight that follows from it.
const OUTCOMES = [
  { text: "Every set reached 8", kg: 62.5, why: "Up one step." },
  { text: "In the range, short of 8", kg: 60, why: "The same weight, and one more rep." },
  { text: "Two or more reps under 6", kg: 57.5, why: "One step down, about 5% lighter." },
];
// Three steps of the gym's weights, drawn as the mark's steps: each rises as far as it runs, and
// its weight lies on its tread.
const STEPS = [57.5, 60, 62.5];
// The plates this gym has, heaviest first, in the app's colours, and what goes on each side of the
// bar for a weight.
const PLATES: [number, string][] = [[20, "#2f6fdb"], [10, "#3b9c55"], [5, "#f2f2f2"], [2.5, "#d9453b"], [1.25, "#a7adb4"]];
function side(kg: number) {
  const loaded: [number, string][] = [];
  let left = kg / 2;
  for (const plate of PLATES) {
    while (left >= plate[0] - 1e-9) {
      loaded.push(plate);
      left -= plate[0];
    }
  }
  return loaded;
}
const [RUN, RISE] = [2.7, 1];
const project = ([x, y, z]: number[]) => [0.866 * (x - y), 0.5 * (x + y) - z];
const rungs = STEPS.map((kg, at) => {
  const high = (at + 1) * RISE;
  const faces = {
    side: [[RUN, -at, high - RISE], [RUN, -at, high], [RUN, -at - 1, high], [RUN, -at - 1, 0], [RUN, -at, 0]],
    riser: [[0, -at, high], [RUN, -at, high], [RUN, -at, high - RISE], [0, -at, high - RISE]],
    tread: [[0, -at, high], [RUN, -at, high], [RUN, -at - 1, high], [0, -at - 1, high]],
  };
  return { kg, faces: Object.entries(faces).map(([face, points]) => ({ face, points: points.map(project) })), label: project([RUN / 2, -at - 0.5, high]) };
}).reverse();
const corners = rungs.flatMap(({ faces }) => faces.flatMap(({ points }) => points));
const [left, top] = [0, 1].map((axis) => Math.min(...corners.map((point) => point[axis])) - 0.05);
const [right, bottom] = [0, 1].map((axis) => Math.max(...corners.map((point) => point[axis])) + 0.05);
const path = (points: number[][]) => `M${points.map((point) => point.map((value) => value.toFixed(3)).join(",")).join("L")}Z`;
---

{/* Before the first paint, so the page never jumps from one layout to the other. */}
<script is:inline>
  (() => {
    const wide = matchMedia("(min-width: 60rem) and (prefers-reduced-motion: no-preference)");
    const draws = () => {
      try {
        return Boolean(document.createElement("canvas").getContext("webgl2"));
      } catch {
        return false;
      }
    };
    let able;
    // Sets the page to "live", the 3D phone, or "still", the pictures of it, and says whether it
    // is live. `broken` is passed when the 3D phone failed: the page then keeps to the stills.
    window.setHomePhone = (broken) => {
      if (broken) able = false;
      else if (wide.matches) able ??= draws();
      const live = wide.matches && able;
      document.documentElement.dataset.home = live ? "live" : "still";
      return live;
    };
    window.setHomePhone();
    wide.addEventListener("change", () => window.dispatchEvent(new Event("homephone")));
  })();
</script>

<div class="home">
  <div class="home-top grid">
    {/* Behind the live phone, and behind the opening still where the stills stand beside the text. */}
    <BigMark />
    <div class="home-copy">
      <section class="hero">
        <h1 id="_top" data-page-title><span>Overload</span> <span>Vector</span></h1>
        <p class="lead">
          <b>Strength training for Android.</b> Run a periodized program, log every set and get the next weight from
          your last session. Can't train as planned? Claude can propose what to change.
        </p>
        <div class="actions">
          <a class="ov-go" href="#start">Get the beta</a>
          <a class="ov-alt" href={INSTALL}>Read the docs</a>
        </div>
        <div class="phone-still">
          {/* Behind the opening still on a narrow screen. */}
          <BigMark />
          <Image src={still("phone-today-light")} alt={TODAY.alt} width={360} densities={[1, 2]} loading="lazy" />
          <Image src={still("phone-today-dark")} alt={TODAY.alt} width={360} densities={[1, 2]} loading="lazy" />
        </div>
      </section>
      <ul class="facts">
        {FACTS.map(({ text, icon }) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon} /></svg>
            {text}
          </li>
        ))}
      </ul>
      {FEATURES.map(({ screens, kicker, title, text, points, more, alts }) => (
        <section class="home-feature" id={kicker.toLowerCase()} data-screen={live(screens).join(" ")}>
          <h2>{title}</h2>
          <p class="lead">{text}</p>
          <div class="inst">
            {kicker === "Program" && (
              <Fragment>
                <div class="block" role="img" aria-label="A 12-week block of three training days a week, with four weeks done and week 5's second day next">
                  <span></span>
                  {WEEKS.map((week) => <span>{week}</span>)}
                  {DAYS.map((day, row) => (
                    <Fragment>
                      <span class="day">Day {day}</span>
                      {WEEKS.map((week) => <i class={dayState(week, row)}></i>)}
                    </Fragment>
                  ))}
                </div>
                <p class="note"><b>Full Body, 3 days.</b> 12 weeks, 60 minutes a day, built for the gym you set up.</p>
              </Fragment>
            )}
            {kicker === "Logging" && (
              <Fragment>
                <div class="set">
                  <span class="fig">50<small>kg</small></span>
                  <span class="x">×</span>
                  <span class="fig">8<small>reps</small></span>
                </div>
                <div class="rir" role="group" aria-label="Reps in reserve">
                  {RIR.map(({ label, tone, say, pressed }) => (
                    <button type="button" class={tone} aria-pressed={pressed ? "true" : "false"} data-say={say}>{label}</button>
                  ))}
                  <span class="note" id="rir-say" aria-live="polite">{RIR.find(({ pressed }) => pressed)?.say}</span>
                </div>
              </Fragment>
            )}
            {kicker === "Technique" && (
              <Fragment>
                <ul class="muscles" aria-label="The muscles a Smith machine RDL works">
                  {MUSCLES.map(([muscle, share]) => <li class={share === 1 ? "main" : undefined} style={`--share:${share}`}>{muscle}</li>)}
                </ul>
              </Fragment>
            )}
            {kicker === "Progression" && (
              <Fragment>
                <p class="ask">Last time: 60 kg, aiming for 6 to 8 reps with 2 in reserve. How did it go?</p>
                <div class="outcomes" role="group" aria-label="How the last session went">
                  {OUTCOMES.map(({ text, kg, why }, at) => (
                    <button type="button" data-kg={kg} data-why={why} data-side={JSON.stringify(side(kg))} aria-pressed={at === 0 ? "true" : "false"}>{text}</button>
                  ))}
                </div>
                <div class="rungs">
                  <svg id="rungs" viewBox={`${left} ${top} ${right - left} ${bottom - top}`} role="img" aria-label="Three steps of this gym's weights: 57.5, 60 and 62.5 kg">
                    {rungs.map(({ kg, faces, label }) => (
                      <g data-kg={kg} class={kg === OUTCOMES[0].kg ? "on" : undefined}>
                        {faces.map(({ face, points }) => <path class={face} d={path(points)}></path>)}
                        <text transform={`matrix(.866,.5,-.866,.5,${label.map((value) => value.toFixed(3)).join(",")})`}>{kg}</text>
                      </g>
                    ))}
                  </svg>
                  <div class="verdict-fig" aria-live="polite">
                    <div class="fig"><span id="next-kg">{OUTCOMES[0].kg}</span><small>kg</small></div>
                    <p><span id="next-why">{OUTCOMES[0].why}</span> <span class="aside">A side, on plates this gym has:</span></p>
                    <div class="plates" id="next-plates">
                      {side(OUTCOMES[0].kg).map(([size, colour]) => <span><i style={`--c:${colour}`}></i>1 × {size}</span>)}
                    </div>
                  </div>
                </div>
              </Fragment>
            )}
            {kicker === "Coaching" && (
              <div class="change">
                <p class="said"><b>Something hurts.</b> My wrist, on the Smith machine bench press.</p>
                <h3>For a week: another chest exercise and one more rep in reserve.</h3>
                <dl>
                  <dt>Exercise</dt>
                  <dd><s>Smith machine bench press</s> Machine chest press</dd>
                  <dt>Reps in reserve</dt>
                  <dd><s>2</s> 3</dd>
                </dl>
                <p class="verdict"><span>Ask for changes</span><span>Accept</span></p>
              </div>
            )}
          </div>
          <ul class="points">
            {points.map((point) => <li>{point}</li>)}
          </ul>
          <a class="more" href={more.href}>{more.text}</a>
          <div class="phone-still">
            {/* Technique's is its second screen, the mannequin with its muscles lit, as the list is. */}
            <Image src={still(`phone-${screens.at(-1)}-light`)} alt={alts.at(-1)!} width={360} densities={[1, 2]} loading="lazy" />
            <Image src={still(`phone-${screens.at(-1)}-dark`)} alt={alts.at(-1)!} width={360} densities={[1, 2]} loading="lazy" />
          </div>
        </section>
      ))}
    </div>
    <div class="home-stage" data-screens={JSON.stringify(screens)}>
      <Image class="stage-opening" src={still("phone-today-light")} alt="" width={360} densities={[1, 2]} loading="lazy" />
      <Image class="stage-opening" src={still("phone-today-dark")} alt="" width={360} densities={[1, 2]} loading="lazy" />
      <canvas role="img" aria-label={TODAY.alt}></canvas>
    </div>
  </div>

  <div class="home-closing grid">
    <section>
      <h2>Your training stays on your phone</h2>
      <p>
        No account, no ads, no trackers. Your training leaves the phone only through what you switch on, and
        the <a href="/privacy/">privacy policy</a> lists each case.
      </p>
    </section>
  </div>
  <div class="home-cta grid" id="start">
    <Mark />
    <h2>Start training</h2>
    <div class="actions">
      <a class="ov-go" href={BETA}>Get the beta</a>
      <a class="ov-alt" href={INSTALL}>Install guide</a>
    </div>
  </div>
</div>

<script>
  // three.js and the phone come in their own file, asked for only when the live phone runs and
  // only once the page has been drawn.
  let started = false;
  function start() {
    // Set anew each time the window changes, also once the phone runs.
    const live = window.setHomePhone();
    if (started || !live) return;
    started = true;
    const stage = document.querySelector(".home-stage");
    const load = () =>
      import("../phone/stage.js")
        .then(({ startStage }) => startStage(stage))
        .catch(() => window.setHomePhone(true));
    if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 1500 });
    else setTimeout(load, 200);
  }
  window.addEventListener("homephone", start);
  start();
</script>

<script>
  // The sections' small working models. Each is whole without this: the page says what a first
  // choice gives, and this lets the reader make another.
  const all = <T extends Element>(selector: string) => [...document.querySelectorAll<T>(selector)];
  const press = (pressed: Element, among: Element[]) => among.forEach((one) => one.setAttribute("aria-pressed", String(one === pressed)));

  // Logging: pick how hard the set was.
  const chips = all<HTMLButtonElement>(".rir button");
  for (const chip of chips) {
    chip.addEventListener("click", () => {
      press(chip, chips);
      document.querySelector("#rir-say")!.textContent = chip.dataset.say!;
    });
  }

  // Progression: the step you take, and what goes on each side of the bar for it.
  const outcomes = all<HTMLButtonElement>(".outcomes button");
  function next(outcome: HTMLButtonElement) {
    press(outcome, outcomes);
    const kg = Number(outcome.dataset.kg);
    for (const step of all<SVGGElement>("#rungs g")) step.classList.toggle("on", Number(step.dataset.kg) === kg);
    document.querySelector("#next-kg")!.textContent = String(kg);
    document.querySelector("#next-why")!.textContent = outcome.dataset.why!;
    document.querySelector("#next-plates")!.replaceChildren(
      ...(JSON.parse(outcome.dataset.side!) as [number, string][]).map(([size, colour]) => {
        const plate = document.createElement("span");
        const swatch = document.createElement("i");
        swatch.style.setProperty("--c", colour);
        plate.append(swatch, `1 × ${size}`);
        return plate;
      }),
    );
  }
  for (const outcome of outcomes) outcome.addEventListener("click", () => next(outcome));
</script>
<style>
  /* The home page is as wide as the window: Starlight's column and its padding step aside. */
  :global(:root[data-home]) {
    --sl-content-width: 100%;
    --sl-content-pad-x: 0rem;
  }
  :global(:root[data-home] .content-panel) {
    padding-block: 0;
  }
  :global(:root[data-home] .sl-container > *) {
    margin-top: 0;
  }
  .home {
    --head: var(--sl-nav-height);
    overflow-x: clip;
    font-size: clamp(1rem, calc(1.15 * var(--ov-u)), 1.375rem);
    line-height: 1.55;
    color: var(--ov-ink);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--ov-gut);
    padding-inline: var(--ov-m);
  }
  .home-copy,
  .home-closing section,
  .home-cta > * {
    grid-column: 1 / -1;
  }
  h1,
  h2,
  .fig {
    font-family: var(--ov-font-title);
    font-stretch: 75%;
    font-weight: 800;
    font-variant-numeric: normal;
    line-height: 0.86;
    color: inherit;
  }
  h1,
  h2 {
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  h2 {
    font-size: clamp(2.75rem, calc(5.4 * var(--ov-u)), 8rem);
  }
  .lead {
    font-size: 1.2em;
    line-height: 1.45;
    color: var(--ov-muted);
    text-wrap: pretty;
  }
  .lead b,
  .note b {
    font-weight: 500;
    color: var(--ov-ink);
  }
  .note {
    font-size: 0.85em;
    color: var(--ov-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .home :global(:focus-visible) {
    outline: 2px solid var(--ov-ink);
    outline-offset: 3px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0.5em;
  }

  /* ---------- The hero: the name, and the phone standing in front of the mark. ---------- */
  .home-top {
    position: relative;
  }
  .hero {
    padding-block: 1.75rem 0;
  }
  .hero h1 {
    font-size: 23.5vw;
